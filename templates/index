<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Student Skill Gap Analyzer</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<div class="container">
<h1>Student Skill Gap Analyzer</h1>
<p>Compare your skills with the requirements of a target career role.</p>
<form method="post">
<label>Target Role</label>
<select name="role">
{% for r in roles %}<option value="{{ r }}" {% if r == role %}selected{% endif %}>{{ r }}</option>{% endfor %}
</select>
<h3>Your Skills</h3>
<div class="skills">
{% for skill in skills %}<label><input type="checkbox" name="skills" value="{{ skill }}" {% if skill in selected %}checked{% endif %}> {{ skill }}</label>{% endfor %}
</div>
<button type="submit">Analyze Skill Gap</button>
</form>
{% if result %}
<div class="result">
<h2>Analysis</h2>
<p><b>Matched:</b> {{ result.matched|join(", ") if result.matched else "None" }}</p>
<p><b>Missing:</b> {{ result.missing|join(", ") if result.missing else "None" }}</p>
{% if result.recommendations %}<h3>Recommended Learning</h3><ul>{% for r in result.recommendations %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endif %}
</div>
</body>
</html>
